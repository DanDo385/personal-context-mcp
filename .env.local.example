# ============================================================================
# .env.local - YOUR settings for personal-context-mcp
#
# This is where your own values go. Two ways to create it:
#   1. Easiest:  uv run personal-context-mcp init      (asks questions, writes .env.local)
#   2. By hand:  cp .env.local.example .env.local      (then fill in the blanks below)
#
# .env.local is never committed to Git and must never be shared or pasted
# anywhere. It is read by the server, by every personal-context-mcp command,
# and by the Obsidian helper. Every setting is explained in .env.example.
#
# Using 1Password? Keep this file's contents in a 1Password Environment and
# mount it here instead (docs/guides/07-keep-secrets-in-1password.md).
# ============================================================================

# ---- 1. Your address and your account ------------------------------------
# Where the server lives. Local testing: http://localhost:8080
# Online: https://<your-project>.vercel.app  (docs/guides/05-put-it-online.md)
PC_ENVIRONMENT=dev
PC_BASE_URL=http://localhost:8080
PC_ALLOWED_HOSTS=

# The email you sign in to ChatGPT / Claude / Gemini / Grok with. Only these
# accounts are let in. Separate several with commas.
PC_ALLOWED_SUBJECTS=you@example.com

# ---- 2. Sign-in (docs/guides/03-google-sign-in.md) -----------------------
# google once online. For a quick local test, `init` sets up static tokens.
PC_AUTH_MODE=google
PC_OAUTH_CLIENT_ID=
PC_OAUTH_CLIENT_SECRET=
# Any long random string: openssl rand -hex 32
PC_OAUTH_SIGNING_KEY=
PC_CLIENT_SCOPE_POLICY={"*":["*"]}

# ---- 3. Database and file storage (docs/guides/04-database.md) -----------
# Supabase > Connect > Transaction pooler, with your password filled in.
PC_DATABASE_URL=
PC_STORAGE_BACKEND=supabase
PC_SUPABASE_URL=
PC_SUPABASE_SERVICE_KEY=

# ---- 4. Optional extras (docs/guides/09-import-your-history.md) ----------
# TypeSafe (Jev) sorts old chats cheaply. Leave blank to use built-in rules.
PC_CLASSIFIER=rules
PC_TYPESAFE_API_KEY=
# Anthropic reads your most important old chats closely. Leave as none to skip.
PC_EXTRACTION_PROVIDER=none
PC_ANTHROPIC_API_KEY=

# ---- 5. Obsidian helper (docs/guides/08-obsidian.md) ---------------------
# The same random string on both lines: openssl rand -hex 32
PC_WORKER_API_KEY=
OBSIDIAN_SYNC_API_KEY=
OBSIDIAN_SYNC_API_URL=http://localhost:8080
OBSIDIAN_SYNC_VAULT_PATH=~/Obsidian/Personal Context
