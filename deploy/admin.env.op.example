# For commands run from your computer against the production database:
# migrate, check, import, reclassify, review, extract, wiki. Either Supabase
# pooler string works (each migration is a single transaction).
#   op run --env-file=deploy/admin.env.op -- uv run personal-context-mcp migrate
PC_ENVIRONMENT=dev
PC_BASE_URL="op://<vault>/<item-id>/Server/base_url"
PC_DATABASE_URL="op://<vault>/<item-id>/Supabase/database_url_session"
PC_AUTH_MODE=none
PC_STORAGE_BACKEND=supabase
PC_SUPABASE_URL="op://<vault>/<item-id>/Supabase/supabase_url"
PC_SUPABASE_SERVICE_KEY="op://<vault>/<item-id>/Supabase/supabase_service_key"
PC_SUPABASE_BUCKET=personal-context-mcp
PC_SUPABASE_ARCHIVE_BUCKET=personal-context-mcp-archives
PC_CLASSIFIER=jev
PC_TYPESAFE_API_KEY="op://<vault>/<typesafe-item-id>/credential"
PC_EMBEDDING_PROVIDER=none

# Pass-2 deep extraction (`personal-context-mcp extract`), run from this Mac.
PC_EXTRACTION_PROVIDER=anthropic
PC_ANTHROPIC_API_KEY="op://<vault>/<anthropic-item-id>/credential"
PC_EXTRACTION_MODEL=claude-opus-5-5

# Gemini digest (docs/guides/11-gemini-without-custom-apps.md)
PC_GOOGLE_DRIVE_CLIENT_ID="op://<vault>/<item-id>/Google Drive/client_id"
PC_GOOGLE_DRIVE_CLIENT_SECRET="op://<vault>/<item-id>/Google Drive/client_secret"
PC_GOOGLE_DRIVE_REFRESH_TOKEN="op://<vault>/<item-id>/Google Drive/refresh_token"
