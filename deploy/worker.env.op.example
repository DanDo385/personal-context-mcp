# Local Obsidian sync worker (launchd: deploy/obsidian-sync.plist).
OBSIDIAN_SYNC_API_URL="op://<vault>/<item-id>/Server/base_url"
OBSIDIAN_SYNC_API_KEY="op://<vault>/<item-id>/Server/worker_api_key"
OBSIDIAN_SYNC_WORKER_ID=my-computer
OBSIDIAN_SYNC_VAULT_PATH="~/Obsidian/Personal Context"
OBSIDIAN_SYNC_POLL_INTERVAL_SECONDS=30
OBSIDIAN_SYNC_WATCH_FOR_EDITS=true
