# For commands run from this Mac against the production database:
# migrate, check, import, reclassify, review. Uses the session pooler
# (port 5432) because migrations hold one transaction open.
#   op run --env-file=deploy/admin.env.op -- uv run personal-context-mcp migrate
PC_ENVIRONMENT=dev
PC_BASE_URL="op://Dev/Personal Context MCP/Server/base_url"
PC_DATABASE_URL="op://Dev/Personal Context MCP/Supabase/database_url_session"
PC_AUTH_MODE=none
PC_STORAGE_BACKEND=supabase
PC_SUPABASE_URL="op://Dev/Personal Context MCP/Supabase/supabase_url"
PC_SUPABASE_SERVICE_KEY="op://Dev/Personal Context MCP/Supabase/supabase_service_key"
PC_SUPABASE_BUCKET=personal-context-mcp
PC_SUPABASE_ARCHIVE_BUCKET=personal-context-mcp-archives
PC_CLASSIFIER=jev
PC_TYPESAFE_API_KEY="op://Dev/Jev API Key/credential"
PC_EMBEDDING_PROVIDER=none
