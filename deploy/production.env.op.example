# Production environment for Vercel. References only - safe to commit.
# Resolved by `op run` in deploy/vercel-env.sh; values never touch disk.
# Copy to deploy/production.env.op and replace <vault>/<item-id> with your
# own 1Password item (see docs/guides/07-keep-secrets-in-1password.md).
PC_ENVIRONMENT=prod
PC_LOG_LEVEL=INFO
PC_BASE_URL="op://<vault>/<item-id>/Server/base_url"
PC_ALLOWED_HOSTS=memory.example.com

PC_DATABASE_URL="op://<vault>/<item-id>/Supabase/database_url_pooler"
# One connection per serverless instance; the Supabase pooler multiplexes.
PC_DB_POOL_MIN_SIZE=0
PC_DB_POOL_MAX_SIZE=3

PC_AUTH_MODE=google
PC_ALLOWED_SUBJECTS=you@example.com
PC_OAUTH_CLIENT_ID="op://<vault>/<item-id>/Google OAuth/google_client_id"
PC_OAUTH_CLIENT_SECRET="op://<vault>/<item-id>/Google OAuth/google_client_secret"
PC_OAUTH_SIGNING_KEY="op://<vault>/<item-id>/Server/oauth_signing_key"
PC_CLIENT_SCOPE_POLICY={"*":["*"]}
PC_WORKER_API_KEY="op://<vault>/<item-id>/Server/worker_api_key"

PC_STORAGE_BACKEND=supabase
PC_SUPABASE_URL="op://<vault>/<item-id>/Supabase/supabase_url"
PC_SUPABASE_SERVICE_KEY="op://<vault>/<item-id>/Supabase/supabase_service_key"
PC_SUPABASE_BUCKET=personal-context-mcp
PC_SUPABASE_ARCHIVE_BUCKET=personal-context-mcp-archives

PC_CLASSIFIER=jev
PC_TYPESAFE_API_KEY="op://<vault>/<typesafe-item-id>/credential"

PC_EMBEDDING_PROVIDER=none
PC_OBSIDIAN_ENABLED=true
